  "cue_count": 21,
  "cues": [
    {
      "index": 1,
      "text": "이번 FOMC, 금리 동결입니다.",
      "start": 0.0,
      "end": 2.6,
      "duration": 2.6
    },
    {
      "index": 2,
      "text": "3.5에서 3.75퍼센트입니다.",
      "start": 2.6,
      "end": 5.1,
      "duration": 2.5
    },
    {
      "index": 3,
      "text": "여러분, 달라진 게 없을까요?",
      "start": 5.1,
      "end": 6.9,
      "duration": 1.8
    },
    {
      "index": 4,
      "text": "꼭 그렇지는 않습니다.",
      "start": 6.9,
      "end": 8.466667,
      "duration": 1.566667
    },
    {
      "index": 5,
      "text": "봐야 할 건 옆 문장입니다.",
      "start": 8.466667,
      "end": 10.433333,
      "duration": 1.966667
    },
    {
      "index": 6,
      "text": "연준은 경제가 버틴다고 봤습니다.",
      "start": 10.433333,
      "end": 12.6,
      "duration": 2.166667
    },
    {
      "index": 7,
      "text": "기업 투자도 이어진다고 했습니다.",
      "start": 12.6,
      "end": 14.7,
      "duration": 2.1
    },
    {
      "index": 8,
      "text": "그럼 이제 안심해도 될까요?",
      "start": 14.7,
      "end": 16.533333,
      "duration": 1.833333
    },
    {
      "index": 9,
      "text": "아직은 아닙니다.",
      "start": 16.533333,
      "end": 17.833333,
      "duration": 1.3
    },
    {
      "index": 10,
      "text": "물가는 목표보다 높습니다.",
      "start": 17.833333,
      "end": 19.466667,
      "duration": 1.633333
    },
    {
      "index": 11,
      "text": "목표는 2퍼센트입니다.",
      "start": 19.466667,
      "end": 21.0,
      "duration": 1.533333
    },
    {
      "index": 12,
      "text": "그럼 물가 부담은 끝났을까요?",
      "start": 21.0,
      "end": 22.966667,
      "duration": 1.966667
    },
    {
      "index": 13,
      "text": "그렇지 않습니다.",
      "start": 22.966667,
      "end": 24.133333,
      "duration": 1.166667
    },
    {
      "index": 14,
      "text": "에너지 가격도 영향을 줬습니다.",
      "start": 24.133333,
      "end": 26.366667,
      "duration": 2.233333
    },
    {
      "index": 15,
      "text": "좋은 신호만 있는 건 아닙니다.",
      "start": 26.366667,
      "end": 28.233333,
      "duration": 1.866667
    },
    {
      "index": 16,
      "text": "그래서 동결만 보면 안 됩니다.",
      "start": 28.233333,
      "end": 30.333333,
      "duration": 2.1
    },
    {
      "index": 17,
      "text": "왜 동결했는지도 봐야 합니다.",
      "start": 30.366667,
      "end": 32.333333,
      "duration": 1.966667
    },
    {
      "index": 18,
      "text": "먼저 금리는 그대로입니다.",
      "start": 32.333333,
      "end": 34.166667,
      "duration": 1.833333
    },
    {
      "index": 19,
      "text": "하지만 물가는 아직 높습니다.",
      "start": 34.166667,
      "end": 36.433333,
      "duration": 2.266667
    },
    {
      "index": 20,
      "text": "경제와 고용은 버티고 있습니다.",
      "start": 36.433333,
      "end": 38.5,
      "duration": 2.066667
    },
    {
      "index": 21,
      "text": "다음 발표도 세 줄만 보면 됩니다.",
      "start": 38.5,
      "end": 40.4,
      "duration": 1.9
    }
  ],
