  "chunks": [
    {
      "index": 1,
      "text": "삼성전자와 SK하이닉스,",
      "start": 0.366667,
      "end": 1.7,
      "duration": 1.333333
    },
    {
      "index": 2,
      "text": "PER 4배라고요.",
      "start": 2.0,
      "end": 2.666667,
      "duration": 0.666667
    },
    {
      "index": 3,
      "text": "정말 싸다는 말이 맞는 걸까요?",
      "start": 3.0,
      "end": 4.333333,
      "duration": 1.333333
    },
    {
      "index": 4,
      "text": "그 수치를 믿기 전에",
      "start": 4.633333,
      "end": 5.566667,
      "duration": 0.933333
    },
    {
      "index": 5,
      "text": "확인할 게 있습니다.",
      "start": 5.7,
      "end": 6.466667,
      "duration": 0.766667
    },
    {
      "index": 6,
      "text": "코스피는 8월 21일",
      "start": 6.733333,
      "end": 7.866667,
      "duration": 1.133333
    },
    {
      "index": 7,
      "text": "6912포인트였습니다.",
      "start": 8.033333,
      "end": 9.566667,
      "duration": 1.533333
    },
    {
      "index": 8,
      "text": "7월 말 저점에서 빠르게",
      "start": 9.766667,
      "end": 10.9,
      "duration": 1.133333
    },
    {
      "index": 9,
      "text": "반등한 수치죠.",
      "start": 11.066667,
      "end": 11.666667,
      "duration": 0.6
    },
    {
      "index": 10,
      "text": "이 흐름 속에서 지금이",
      "start": 11.933333,
      "end": 13.0,
      "duration": 1.066667
    },
    {
      "index": 11,
      "text": "싸다는 믿음이 퍼졌습니다.",
      "start": 13.1,
      "end": 14.266667,
      "duration": 1.166667
    },
    {
      "index": 12,
      "text": "삼성전자는 코스피 시총",
      "start": 14.633333,
      "end": 15.866667,
      "duration": 1.233333
    },
    {
      "index": 13,
      "text": "1위 종목입니다.",
      "start": 15.966667,
      "end": 16.6,
      "duration": 0.633333
    },
    {
      "index": 14,
      "text": "SK하이닉스는 바로",
      "start": 16.866667,
      "end": 17.9,
      "duration": 1.033333
    },
    {
      "index": 15,
      "text": "뒤를 잇는 2위죠.",
      "start": 17.966667,
      "end": 18.8,
      "duration": 0.833333
    },
    {
      "index": 16,
      "text": "두 종목 밸류에이션이",
      "start": 19.066667,
      "end": 20.0,
      "duration": 0.933333
    },
    {
      "index": 17,
      "text": "흔들리면 코스피 해석도 달라집니다.",
      "start": 20.066667,
      "end": 21.8,
      "duration": 1.733333
    },
    {
      "index": 18,
      "text": "그런데 PER 4배, 어디서",
      "start": 22.033333,
      "end": 23.4,
      "duration": 1.366667
    },
    {
      "index": 19,
      "text": "나온 수치일까요?",
      "start": 23.466667,
      "end": 24.1,
      "duration": 0.633333
    },
    {
      "index": 20,
      "text": "검증 가능한 EPS",
      "start": 24.466667,
      "end": 25.4,
      "duration": 0.933333
    },
    {
      "index": 21,
      "text": "추정치가 없습니다.",
      "start": 25.466667,
      "end": 26.3,
      "duration": 0.833333
    },
    {
      "index": 22,
      "text": "컨센서스 데이터도 확인되지 않죠.",
      "start": 26.633333,
      "end": 28.266667,
      "duration": 1.633333
    },
    {
      "index": 23,
      "text": "근거 자체가 없는 겁니다.",
      "start": 28.566667,
      "end": 29.6,
      "duration": 1.033333
    },
    {
      "index": 24,
      "text": "PER은 주가를 이익으로",
      "start": 29.733333,
      "end": 31.0,
      "duration": 1.266667
    },
    {
      "index": 25,
      "text": "나눈 값입니다.",
      "start": 31.1,
      "end": 31.7,
      "duration": 0.6
    },
    {
      "index": 26,
      "text": "분모인 이익 추정치를",
      "start": 32.066667,
      "end": 33.133333,
      "duration": 1.066667
    },
    {
      "index": 27,
      "text": "어떻게 잡느냐가 핵심이죠.",
      "start": 33.233333,
      "end": 34.466667,
      "duration": 1.233333
    },
    {
      "index": 28,
      "text": "추정치에 따라 결과가",
      "start": 34.733333,
      "end": 35.766667,
      "duration": 1.033333
    },
    {
      "index": 29,
      "text": "완전히 달라집니다.",
      "start": 35.9,
      "end": 36.633333,
      "duration": 0.733333
    },
    {
      "index": 30,
      "text": "낙관적 전망을 쓰면 주가가",
      "start": 36.866667,
      "end": 38.166667,
      "duration": 1.3
    },
    {
      "index": 31,
      "text": "싸 보이거든요.",
      "start": 38.3,
      "end": 38.866667,
      "duration": 0.566667
    },
    {
      "index": 32,
      "text": "보수적으로 잡으면 달라질 수 있죠.",
      "start": 39.166667,
      "end": 40.666667,
      "duration": 1.5
    },
    {
      "index": 33,
      "text": "하반기 이익 추정치는",
      "start": 40.966667,
      "end": 41.9,
      "duration": 0.933333
    },
    {
      "index": 34,
      "text": "아직 불확실하죠.",
      "start": 42.0,
      "end": 42.733333,
      "duration": 0.733333
    },
    {
      "index": 35,
      "text": "같은 주가도 분모에 따라",
      "start": 43.066667,
      "end": 44.166667,
      "duration": 1.1
    },
    {
      "index": 36,
      "text": "다르게 읽힙니다.",
      "start": 44.266667,
      "end": 44.9,
      "duration": 0.633333
    },
    {
      "index": 37,
      "text": "검증 안 된 수치로 판단해도 될까요?",
      "start": 45.266667,
      "end": 46.8,
      "duration": 1.533333
    },
    {
      "index": 38,
      "text": "하나의 기준만 기억해 두세요.",
      "start": 47.1,
      "end": 48.333333,
      "duration": 1.233333
    },
    {
      "index": 39,
      "text": "분모가 어떤 이익 추정치인지",
      "start": 48.666667,
      "end": 50.1,
      "duration": 1.433333
    },
    {
      "index": 40,
      "text": "직접 확인하세요.",
      "start": 50.233333,
      "end": 50.866667,
      "duration": 0.633333
    },
    {
      "index": 41,
      "text": "낙관치인지 보수치인지가",
      "start": 51.133333,
      "end": 52.466667,
      "duration": 1.333333
    },
    {
      "index": 42,
      "text": "먼저인 겁니다.",
      "start": 52.6,
      "end": 53.133333,
      "duration": 0.533333
    },
    {
      "index": 43,
      "text": "그 확인이 판단의 시작이니까요.",
      "start": 53.4,
      "end": 54.9,
      "duration": 1.5
    },
    {
      "index": 44,
      "text": "PER 숫자 하나보다 근거가",
      "start": 55.166667,
      "end": 56.366667,
      "duration": 1.2
    },
    {
      "index": 45,
      "text": "더 중요합니다.",
      "start": 56.433333,
      "end": 56.933333,
      "duration": 0.5
    }
  ],
