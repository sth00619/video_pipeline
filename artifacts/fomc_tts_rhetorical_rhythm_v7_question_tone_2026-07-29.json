  "cue_count": 28,
  "cues": [
    {
      "index": 1,
      "text": "이번 FOMC, 금리 동결입니다.",
      "start": 0.0,
      "end": 2.533333,
      "duration": 2.533333
    },
    {
      "index": 2,
      "text": "3.5에서 3.75퍼센트입니다.",
      "start": 2.533333,
      "end": 5.033333,
      "duration": 2.5
    },
    {
      "index": 3,
      "text": "여러분, 달라진 게 없을까요?",
      "start": 5.033333,
      "end": 6.533333,
      "duration": 1.5
    },
    {
      "index": 4,
      "text": "꼭 그렇지는 않습니다.",
      "start": 6.566667,
      "end": 7.866667,
      "duration": 1.3
    },
    {
      "index": 5,
      "text": "봐야 할 건 옆 문장입니다.",
      "start": 7.866667,
      "end": 9.7,
      "duration": 1.833333
    },
    {
      "index": 6,
      "text": "연준은 경제가 버틴다고 봤습니다.",
      "start": 9.7,
      "end": 11.6,
      "duration": 1.9
    },
    {
      "index": 7,
      "text": "기업 투자도 이어진다고 했습니다.",
      "start": 11.6,
      "end": 13.466667,
      "duration": 1.866667
    },
    {
      "index": 8,
      "text": "그럼 이제 안심해도 될까요?",
      "start": 13.466667,
      "end": 15.166667,
      "duration": 1.7
    },
    {
      "index": 9,
      "text": "아직은 아닙니다.",
      "start": 15.166667,
      "end": 16.3,
      "duration": 1.133333
    },
    {
      "index": 10,
      "text": "물가는 목표보다 높습니다.",
      "start": 16.3,
      "end": 17.733333,
      "duration": 1.433333
    },
    {
      "index": 11,
      "text": "목표는 2퍼센트입니다.",
      "start": 17.733333,
      "end": 19.133333,
      "duration": 1.4
    },
    {
      "index": 12,
      "text": "그럼 물가 부담은 끝났을까요?",
      "start": 19.133333,
      "end": 20.966667,
      "duration": 1.833333
    },
    {
      "index": 13,
      "text": "그렇지 않습니다.",
      "start": 20.966667,
      "end": 21.933333,
      "duration": 0.966667
    },
    {
      "index": 14,
      "text": "에너지 가격까지 물가에",
      "start": 21.933333,
      "end": 23.466667,
      "duration": 1.533333
    },
    {
      "index": 15,
      "text": "영향을 주고 있습니다.",
      "start": 23.466667,
      "end": 25.066667,
      "duration": 1.6
    },
    {
      "index": 16,
      "text": "좋은 신호만 있는",
      "start": 25.066667,
      "end": 26.0,
      "duration": 0.933333
    },
    {
      "index": 17,
      "text": "상황은 아닌 겁니다.",
      "start": 26.0,
      "end": 27.266667,
      "duration": 1.266667
    },
    {
      "index": 18,
      "text": "그러니 동결이라는 결과만 보고",
      "start": 27.266667,
      "end": 29.0,
      "duration": 1.733333
    },
    {
      "index": 19,
      "text": "넘어가면 안 됩니다.",
      "start": 29.0,
      "end": 30.3,
      "duration": 1.3
    },
    {
      "index": 20,
      "text": "왜 금리를 그대로 뒀는지,",
      "start": 30.333333,
      "end": 31.7,
      "duration": 1.366667
    },
    {
      "index": 21,
      "text": "그 이유까지 같이 봐야겠죠.",
      "start": 31.766667,
      "end": 33.466667,
      "duration": 1.7
    },
    {
      "index": 22,
      "text": "그럼 세 가지만 정리해보겠습니다.",
      "start": 33.466667,
      "end": 36.033333,
      "duration": 2.566667
    },
    {
      "index": 23,
      "text": "금리는 그대로, 물가는",
      "start": 36.033333,
      "end": 37.533333,
      "duration": 1.5
    },
    {
      "index": 24,
      "text": "여전히 높은 상태입니다.",
      "start": 37.533333,
      "end": 39.166667,
      "duration": 1.633333
    },
    {
      "index": 25,
      "text": "경제와 고용은 예상보다",
      "start": 39.166667,
      "end": 40.933333,
      "duration": 1.766667
    },
    {
      "index": 26,
      "text": "잘 버티고 있고요.",
      "start": 41.0,
      "end": 42.066667,
      "duration": 1.066667
    },
    {
      "index": 27,
      "text": "다음 발표에서도 이 세 가지가",
      "start": 42.066667,
      "end": 44.0,
      "duration": 1.933333
    },
    {
      "index": 28,
      "text": "어떻게 달라졌는지만 보면 됩니다.",
      "start": 44.0,
      "end": 46.5,
      "duration": 2.5
    }
  ],
